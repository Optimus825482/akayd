# ===========================================
# Akaydın Tarım — Ortam Değişkenleri (.env)
# ===========================================
# Bu dosyayı ".env" olarak kopyalayıp değerleri doldurun.
# cp .env.example .env
# ===========================================

# --- Veritabanı ---
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_NAME=akaydin_tarim
DB_PORT=5432

# --- Admin ---
ADMIN_PASSWORD=admin_secure_password

# --- JWT ---
JWT_SECRET=your_jwt_secret_here_change_in_production

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Ortam ---
NODE_ENV=development

# --- Gemini AI (SEO analiz için) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Uploads ---
UPLOADS_DIR=./uploads

# --- Google Search Console (SERP Rank Tracker) ---
# Service account JSON key dosyasının yolu (proje kökünde gsc-key.json)
# Kurulum: Google Cloud Console → Search Console API → Service Account → JSON key indir
GSC_KEY_FILE=./gsc-key.json
# Search Console'da kayıtlı site URL'si
GSC_SITE_URL=https://www.akaydintarim.com.tr

# --- Frontend ---
VITE_API_URL=http://localhost:3003
