# ============================================
# Akaydın Tarım — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun
# cp .env.example .env
# ============================================

# --- Veritabanı (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=akaydin_tarim

# --- Admin ---
# Admin panele giriş şifresi
ADMIN_PASSWORD=change_me_admin

# JWT için gizli anahtar (üretimde güçlü bir değer kullanın)
# Rastgele oluşturmak için: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_jwt_secret_64chars

# --- Sunucu ---
PORT=3003
NODE_ENV=development

# --- CORS ---
# Virgülle ayrılmış izin verilen origin'ler
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Upload ---
# Dosya yüklemeleri için klasör yolu
UPLOADS_DIR=./uploads

# --- Gemini AI ---
# AI destekli özellikler için (opsiyonel)
GEMINI_API_KEY=

# --- Vite Frontend ---
VITE_API_URL=http://localhost:3003/api
VITE_STATIC_URL=http://localhost:3003

# --- SerpRank Tracker ---
# SERP kontrolü için proxy (opsiyonel)
# SERP_PROXY_URL=http://proxy:8080
