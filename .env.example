# ============================================
# Akaydın Tarım — Production Environment
# Domain: https://akaydintarim.com.tr
# ============================================

# Veritabanı
DB_HOST=postgres
DB_USER=postgres
DB_PASSWORD=GUCLU_BIR_SIFRE
DB_NAME=akaydin_tarim
DB_PORT=5432

# Admin Paneli
ADMIN_PASSWORD=GUCLU_ADMIN_SIFRESI

# Sunucu
PORT=3003
NODE_ENV=production

# Frontend (Vite için VITE_ prefix zorunlu)
# Production'da API aynı domain'den serve ediliyor
VITE_API_URL=/api
VITE_STATIC_URL=

# CORS (virgülle ayrılmış origin listesi)
CORS_ORIGINS=https://akaydintarim.com.tr,https://www.akaydintarim.com.tr
# Local dev için ekle: ,http://localhost:5173,http://localhost:3000
