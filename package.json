{
  "name": "akaydin-tarim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "nodemon server/index.js",
    "start": "node --max-old-space-size=128 --no-compilation-cache --no-lazy server/index.js",
    "start-prod": "node --max-old-space-size=256 --no-compilation-cache --no-lazy server/index.js",
    "start-minimal": "node --max-old-space-size=64 --no-compilation-cache --no-lazy --gc-interval=100 server/index.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pg": "^8.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^1.3.0",
    "react-icons": "^4.12.0",
    "react-router-dom": "^6.15.0",
    "recharts": "^2.15.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/multer": "^1.4.7",
    "@types/node": "^18.17.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.4",
    "nodemon": "^3.0.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.1.6",
    "vite": "^4.4.5"
  }
}
